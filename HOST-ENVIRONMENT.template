# Use this as a reference for a secret manager; do not commit real values.
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://iwantphoto.com
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/iwantphoto
JWT_SECRET=generate-a-long-random-secret-at-least-32-bytes

# Google sign-in (OAuth client type "Web application").
# Authorized redirect URI: https://iwantphoto.com/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Verified Google email that receives the admin role on sign-in.
OWNER_EMAIL=

# OpenRouter (image editing + vision/JSON LLM).
OPENROUTER_API_KEY=
# Optional overrides; defaults shown.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_IMAGE_FALLBACK_MODEL=openai/gpt-5-image
# Used only when a call site passes no model.
OPENROUTER_LLM_MODEL=

# S3-compatible bucket (Railway Bucket, R2, B2, MinIO, AWS S3).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Stripe server credentials and product Price IDs.
IWANTPHOTO_BILLING_ENABLED=false
IWANTPHOTO_STRIPE_SECRET_KEY=
IWANTPHOTO_STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
IWANTPHOTO_STRIPE_CREDIT_FLEX_25_PRICE_ID=
IWANTPHOTO_STRIPE_CREDIT_VALUE_100_PRICE_ID=
IWANTPHOTO_STRIPE_CREDIT_STUDIO_250_PRICE_ID=

# Resend storage-capacity notices.
IWANTPHOTO_RESEND_API_KEY=
IWANTPHOTO_RESEND_FROM_EMAIL=Iwantphoto <alerts@iwantphoto.com>

# Optional build-time analytics configuration.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
