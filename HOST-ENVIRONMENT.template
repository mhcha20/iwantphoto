# Use this as a reference for a secret manager; do not commit real values.
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://iwantphoto.com
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/iwantphoto
JWT_SECRET=generate-a-long-random-secret-at-least-32-bytes

# Option A: retain Manus OAuth temporarily. Option B: replace the OAuth implementation.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Option A: retain Manus Forge temporarily. Option B: replace storage and AI adapters.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Stripe server credentials and product Price IDs.
IWANTPHOTO_BILLING_ENABLED=false
IWANTPHOTO_STRIPE_SECRET_KEY=
IWANTPHOTO_STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
IWANTPHOTO_STRIPE_CREDIT_FLEX_25_PRICE_ID=
IWANTPHOTO_STRIPE_CREDIT_VALUE_100_PRICE_ID=
IWANTPHOTO_STRIPE_CREDIT_STUDIO_250_PRICE_ID=

# Resend storage-capacity notices.
IWANTPHOTO_RESEND_API_KEY=
IWANTPHOTO_RESEND_FROM_EMAIL=Iwantphoto <alerts@iwantphoto.com>

# Optional build-time analytics configuration.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
